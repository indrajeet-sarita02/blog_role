{
  "name": "blog-backend",
  "version": "1.0.0",
  "description": "Blog application backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --exec ts-node -r tsconfig-paths/register src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc && tsc-alias",
    "seed": "ts-node -r tsconfig-paths/register src/database/seeders/seed.ts",
    "seed:sample": "ts-node -r tsconfig-paths/register src/database/seeders/sample.ts",
    "start": "node dist/server.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.3.0",
    "sanitize-html": "^2.13.0",
    "sequelize": "^6.37.3",
    "sqlite3": "^5.1.7",
    "uuid": "^14.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.0",
    "@types/sanitize-html": "^2.16.1",
    "@types/uuid": "^11.0.0",
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.3",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.5"
  }
}
