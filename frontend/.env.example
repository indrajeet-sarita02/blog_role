# Prisma Accelerate connection string (used by the app at runtime / on Vercel).
# Must be set in the Vercel project environment variables. Example:
# prisma+postgres://accelerate.prisma-data.net/?api_key=<YOUR_ACCELERATE_API_KEY>
DATABASE_URL=

# Direct Prisma Postgres connection string (used ONLY for prisma db push / migrate).
# Points to the same database; the app schema/table live in the "blog_role" schema.
# Example:
# postgres://<user>:<password>@db.prisma.io:5432/postgres?sslmode=require
# To apply schema changes:
#   DATABASE_URL="$PRISMA_DATABASE_URL" npx prisma db push
PRISMA_DATABASE_URL=